package practice_14.zadanie2;

public class Main {
    static void main(String[] args) {

        DiscountCalculator calc = new DiscountCalculator();

        System.out.println("Обычный клиент: " + calc.calculateDiscount(1000, false, false, false));    // 980
        System.out.println("С купоном: " + calc.calculateDiscount(1000, false, false, true));          // 930
        System.out.println("Лояльный: " + calc.calculateDiscount(1000, true, false, false));           // 950
        System.out.println("Лояльный + первая покупка: " + calc.calculateDiscount(1000, true, true, false)); // 900
    }
}
